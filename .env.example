APP_NAME="دورك - Dawrak"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-railway-url.railway.app
FRONTEND_URL=https://your-frontend-url.railway.app

LOG_CHANNEL=stderr
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql.railway.internal
DB_PORT=3306
DB_DATABASE=dawrak
DB_USERNAME=root
DB_PASSWORD=your_password

# Queue - استخدام قاعدة البيانات للطابور
QUEUE_CONNECTION=database

# Cache
CACHE_STORE=database

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120

# WhatsApp - Twilio (اختياري)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# WhatsApp - CallMeBot (مجاني، استخدمه كبديل)
CALLMEBOT_ENABLED=true
CALLMEBOT_API_KEY=
